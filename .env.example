OPENAI_API_KEY=
# OpenAI Responses model used by the Rust agent runtime.
TROCODE_AGENT_MODEL=gpt-5.6-luna
TROCODE_AGENT_MODEL_ALLOWLIST=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol

# Durable backend-owned Rust runtime. Keep disabled until encryption,
# canary, benchmark, privacy-notice, and rollback gates are satisfied.
# The desktop always fails closed when this runtime is unavailable; there is no
# TypeScript model-loop fallback.
TROCODE_BACKEND_AGENT_ENABLED=false
TROCODE_BACKEND_AGENT_ROLLOUT_PERCENT=0
TROCODE_BACKEND_AGENT_CANARY_USERS=
TROCODE_AGENT_RUNTIME_PROTOCOL_VERSION=2
# Canonical v3 rollout: observe logs compatibility, dual accepts matching v3
# while v2 drains, and enforce permits only matching v3 for new work.
AGENT_RUNTIME_V3_MODE=observe
TROCODE_INTENT_AUTHORIZATION_ENABLED=false
TROCODE_INTENT_AUTHORIZATION_CANARY_USERS=
TROCODE_INTENT_AUTHORIZATION_ROLLOUT_PERCENT=0
# Comma-separated version:base64 entries. Each decoded key must be 32 bytes.
TROCODE_AGENT_STATE_ENCRYPTION_KEYS=
TROCODE_AGENT_STATE_KEY_VERSION=1
TROCODE_AGENT_LEASE_MS=30000
TROCODE_DESKTOP_WORKER_TTL_MS=35000
TROCODE_AGENT_PAYLOAD_TTL_MS=604800000
TROCODE_AGENT_COMPACTION_ITEM_THRESHOLD=80
TROCODE_AGENT_MAX_ACTIVE_RUNS_PER_USER=2
TROCODE_AGENT_MAX_QUEUE_DEPTH=1000
TROCODE_PLAYWRIGHT_CDP_ENABLED=false

# User-scoped connected applications. Gmail is a Developer Preview canary and
# uses a separate Google web OAuth client from desktop identity sign-in.
TROCODE_CONNECTORS_ENABLED=false
TROCODE_CONNECTOR_CANARY_USERS=
TROCODE_CONNECTOR_ROLLOUT_PERCENT=0
TROCODE_CONNECTOR_CALLBACK_URL=https://api.example.com/v1/connectors/oauth/callback
# Comma-separated version:base64 AES-256 keys; do not reuse agent-state keys.
TROCODE_CONNECTOR_TOKEN_ENCRYPTION_KEYS=
TROCODE_CONNECTOR_TOKEN_KEY_VERSION=1
TROCODE_GMAIL_CONNECTOR_CLIENT_ID=
TROCODE_GMAIL_CONNECTOR_CLIENT_SECRET=
TROCODE_CONNECTOR_MAX_SCHEMA_BYTES=128000
TROCODE_CONNECTOR_MAX_RESULT_BYTES=512000
TROCODE_CONNECTOR_MCP_TIMEOUT_MS=30000
TROCODE_CONNECTOR_OAUTH_ATTEMPT_TTL_MS=600000

# Hosted paid-call guard. Tier limits are enforced by the API; these values are
# emergency ceilings and should be at least as high as the Max tier defaults.
TROCODE_COST_GUARD_MODE=enforce
TROCODE_PAID_CALLS_ENABLED=true
TROCODE_MONTHLY_BUDGET_MICRO_USD=45000000
TROCODE_DAILY_BUDGET_MICRO_USD=8000000
TROCODE_TASK_BUDGET_MICRO_USD=5000000
TROCODE_BUDGET_WARNING_PERCENT=80
TROCODE_RESERVATION_TTL_MS=120000
TROCODE_REALTIME_CALL_ESTIMATE_MICRO_USD=5000
TROCODE_SPEECH_MICRO_USD_PER_THOUSAND_CHARACTERS=60000

# Optional companion speech. These values are consumed only by Rust provider
# transports (hosted API or local development sidecar), never renderer code.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PROJECT_ID=

POSTHOG_PROJECT_TOKEN=phc_replace_with_your_project_token
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENVIRONMENT=development

# Local Docker PostgreSQL credentials. Keep real values in Doppler or an
# ignored environment file; never commit them here.
TROCODE_POSTGRES_PASSWORD=
DATABASE_URL=postgresql://trocode:replace_with_local_password@127.0.0.1:54320/trocode?sslmode=disable
TROCODE_DATABASE_POOL_MAX=10

# Hosted Rust API process metadata and opaque-session policy. Railway supplies
# PORT and RAILWAY_GIT_COMMIT_SHA automatically in production.
PORT=8787
RAILWAY_GIT_COMMIT_SHA=development
TROCODE_SESSION_DURATION_DAYS=30
TROCODE_SESSION_TOKEN_HMAC_KEY=
TROCODE_TRANSCRIPTION_MICRO_USD_PER_MINUTE=4500

# Optional server-hosted admin dashboard at /source/admin. Use a unique random
# value of at least 32 characters and keep it in Doppler/Railway only.
TROCODE_ADMIN_ACCESS_TOKEN=

# Knowledge Spaces access is stored per account in
# users.knowledge_spaces_enabled and defaults to enabled. The private
# S3-compatible bucket below is optional for navigation and metadata routes,
# but is required by file upload, download, and ingestion flows.
TROCODE_KNOWLEDGE_S3_ACCESS_KEY_ID=
TROCODE_KNOWLEDGE_S3_SECRET_ACCESS_KEY=
TROCODE_KNOWLEDGE_S3_BUCKET=
TROCODE_KNOWLEDGE_S3_REGION=
TROCODE_KNOWLEDGE_S3_ENDPOINT=
TROCODE_KNOWLEDGE_S3_FORCE_PATH_STYLE=false

# Release-only signing and notarization inputs. Store production values in
# Doppler or GitHub Actions secrets, never in a committed environment file.
TROCODE_MACOS_SIGNING_IDENTITY=
TROCODE_APPLE_API_KEY=
TROCODE_APPLE_API_KEY_ID=
TROCODE_APPLE_API_ISSUER=
TROCODE_WINDOWS_CERTIFICATE_FILE=
TROCODE_WINDOWS_CERTIFICATE_PASSWORD=
