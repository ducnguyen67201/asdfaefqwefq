{
  "name": "trocode",
  "productName": "Tro",
  "version": "0.1.8",
  "description": "A general-purpose, goal-driven desktop agent powered by CUA.",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "agent:protocol:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-agent-runtime-contract.mts --write",
    "agent:protocol:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-agent-runtime-contract.mts --check",
    "agent:orchestrator:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-agent-orchestrator-contract.mts --write",
    "agent:orchestrator:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-agent-orchestrator-contract.mts --check",
    "agent-sdk:install": "npm --prefix services/agent-runtime ci",
    "agent-sdk:typecheck": "npm --prefix services/agent-runtime run typecheck",
    "agent-sdk:test": "npm --prefix services/agent-runtime test",
    "agent-sdk:check": "npm --prefix services/agent-runtime run check",
    "admin:build": "vite build --config apps/admin/vite.config.ts",
    "admin:dev": "vite --config apps/admin/vite.config.ts",
    "start": "npm run dev:stop-existing && npm run db:up && doppler run --project tro-app --config dev -- npm exec -- electron-forge start",
    "dev:stop-existing": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/stop-existing-dev.mts",
    "db:down": "doppler run --project tro-app --config dev -- docker compose down",
    "db:logs": "doppler run --project tro-app --config dev -- docker compose logs --tail=100 postgres",
    "db:ps": "doppler run --project tro-app --config dev -- docker compose ps",
    "db:up": "doppler run --project tro-app --config dev -- docker compose up -d --wait --wait-timeout 60 postgres",
    "engine": "cargo run --manifest-path services/api/Cargo.toml --locked --bin trocode-api --",
    "cost:report": "npm run engine -- cost-report",
    "agent:runtime-versions": "npm run engine -- agent-runtime-versions",
    "agent:benchmark": "npm run engine -- agent-benchmark",
    "bazel:build": "bazel build //services/api:trocode_api",
    "bazel:start": "bazel run //services/api:trocode_api",
    "bazel:test": "bazel test //services/api/...",
    "bazel:check": "bazel test --config=ci //:buildifier_test //services/api/... && bazel build --config=ci //services/api:clippy",
    "cua:report": "npm run engine -- cua-report",
    "package": "npm run admin:build && doppler run --project tro-app --config prd -- npm exec -- electron-forge package",
    "package:dev": "npm run admin:build && doppler run --project tro-app --config dev -- npm exec -- electron-forge package",
    "make": "npm run admin:build && doppler run --project tro-app --config prd -- npm exec -- electron-forge make",
    "make:dev": "npm run admin:build && doppler run --project tro-app --config dev -- npm exec -- electron-forge make",
    "publish": "npm run admin:build && doppler run --project tro-app --config prd -- npm exec -- electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "access-code:create": "npm run engine -- access-code create",
    "membership:keygen": "npm run engine -- membership keygen",
    "membership:issue": "npm run engine -- membership issue",
    "windows:release-metadata": "npm run engine -- windows-release-metadata",
    "typecheck": "tsc --noEmit",
    "api:fmt": "cargo fmt --manifest-path services/api/Cargo.toml --all -- --check",
    "api:lint": "cargo clippy --manifest-path services/api/Cargo.toml --all-targets --all-features -- -D warnings",
    "api:test": "cargo test --manifest-path services/api/Cargo.toml --all-features --locked",
    "api:audit": "cargo audit --file Cargo.lock",
    "api:build": "npm run admin:build && cargo build --manifest-path services/api/Cargo.toml --release --locked",
    "test": "vitest run && npm run api:test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:rust-engine": "npm run engine -- rust-only-check",
    "check": "npm run agent:protocol:check && npm run agent:orchestrator:check && npm run agent-sdk:check && npm run admin:build && npm run agent:runtime-versions && npm run check:rust-engine && npm run lint && npm run typecheck && npm run api:fmt && npm run api:lint && npm run api:audit && npm run test"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "keywords": [
    "ai-agent",
    "computer-use",
    "cua",
    "electron"
  ],
  "author": {
    "name": "Duc Ng",
    "email": "danielbaker06072001@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ducnguyen67201/TroCode.git"
  },
  "overrides": {
    "@electron/rebuild": "4.2.0",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.1",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "webpack-dev-server": "5.2.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-msix": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "css-loader": "^6.11.0",
    "dotenv": "^17.4.2",
    "electron": "43.4.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "happy-dom": "^20.11.13",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@trycua/cua-driver": "0.19.3",
    "electron-squirrel-startup": "^1.0.1",
    "playwright-core": "1.62.1",
    "posthog-node": "^5.49.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zod": "4.4.3"
  }
}
