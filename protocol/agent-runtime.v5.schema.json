      "required": [
        "stage",
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "AgentRunPhaseV5": {
      "enum": [
        "ready",
        "running",
        "paused",
        "awaiting_permission",
        "awaiting_input",
        "acting",
        "completed",
        "blocked",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "AgentRunProjectionV5": {
      "additionalProperties": false,
      "properties": {
        "availableActions": {
          "items": {
            "$ref": "#/$defs/AgentRunActionV5"
          },
          "maxItems": 4,
          "type": "array"
        },
        "cancellationSource": {
          "anyOf": [
            {
              "$ref": "#/$defs/CancellationSourceV5"
