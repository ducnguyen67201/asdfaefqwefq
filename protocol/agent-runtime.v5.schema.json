      "enum": [
        "queued",
        "awaiting_orchestrator",
        "running",
        "awaiting_worker",
        "awaiting_permission",
        "executing_tool",
        "awaiting_input",
        "recovering",
        "completed",
        "blocked",
        "failed",
        "cancelled",
        "expired"
