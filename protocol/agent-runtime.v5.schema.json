              "type": "null"
            }
          ]
        },
        "phase": {
          "$ref": "#/$defs/AgentRunPhaseV5"
        },
        "runVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/AgentRunStateV5"
        },
        "terminal": {
          "type": "boolean"
        },
        "waitingOn": {
          "anyOf": [
            {
              "$ref": "#/$defs/WaitingOnV5"
