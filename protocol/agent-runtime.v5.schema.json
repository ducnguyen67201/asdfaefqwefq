      "type": "string"
    },
    "AgentRunFailureV5": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/AgentRunFailureCodeV5"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
