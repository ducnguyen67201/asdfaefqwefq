{
  "schemaVersion": 4,
  "tools": [
    {
      "description": "Record one review hypothesis for an allowlisted Activity criterion and tag. This is evidence for review, never a grade, diagnosis, or Attempt-state change.",
      "modelName": "record_activity_signal",
      "operationSelector": {
        "kind": "constant",
        "value": "record"
      },
      "operations": [
        "record"
      ],
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "criterionId": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "resultCode": {
            "enum": [
              "observed",
              "passed",
              "failed",
              "blocked",
              "needs_review"
            ],
            "type": "string"
          },
          "tag": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "criterionId",
          "tag",
          "resultCode"
        ],
        "type": "object"
      },
      "prerequisites": [],
      "toolId": "activity.signal"
    },
    {
