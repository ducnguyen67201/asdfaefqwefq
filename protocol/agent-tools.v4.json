    {
      "description": "Execute one exact click, type, key, or scroll action using an opaque ref from the latest observe_surface result. Set description to one concise user-facing sentence stating what will happen; the host shows it immediately before execution. Use desktop control only when the observation route is desktop vision.",
      "modelName": "control_surface",
      "operationSelector": {
        "kind": "json_pointer",
        "pointer": "/command/kind"
      },
      "operations": [
        "click_element",
        "type_text",
        "press_key",
        "scroll"
      ],
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "button": {
                    "enum": [
                      "left",
                      "right"
                    ],
                    "type": "string"
                  },
                  "count": {
                    "maximum": 2,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "kind": {
                    "const": "click_element",
                    "type": "string"
                  },
                  "ref": {
                    "pattern": "^e[1-9][0-9]{0,3}$",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "ref",
                  "button",
                  "count"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "type_text",
                    "type": "string"
                  },
                  "ref": {
                    "pattern": "^e[1-9][0-9]{0,3}$",
                    "type": "string"
                  },
                  "replace": {
                    "type": "boolean"
                  },
                  "text": {
                    "maxLength": 100000,
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "ref",
                  "text",
                  "replace"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "maxLength": 40,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "press_key",
                    "type": "string"
                  },
                  "modifiers": {
                    "items": {
                      "maxLength": 40,
                      "minLength": 1,
                      "type": "string"
                    },
                    "maxItems": 8,
                    "type": "array"
                  },
                  "ref": {
                    "anyOf": [
                      {
                        "pattern": "^e[1-9][0-9]{0,3}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "ref",
                  "key",
                  "modifiers"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "amount": {
                    "maximum": 20,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "direction": {
                    "enum": [
                      "up",
                      "down",
                      "left",
                      "right"
                    ],
                    "type": "string"
                  },
                  "kind": {
                    "const": "scroll",
                    "type": "string"
                  },
                  "ref": {
                    "anyOf": [
                      {
                        "pattern": "^e[1-9][0-9]{0,3}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "ref",
                  "direction",
                  "amount"
                ],
                "type": "object"
              }
            ]
          },
          "description": {
            "maxLength": 2000,
            "type": "string"
          },
          "observationId": {
            "type": "string"
          },
          "target": {
            "anyOf": [
              {
                "maxLength": 8000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "observationId",
          "description",
          "target",
          "command"
        ],
        "type": "object"
      },
      "prerequisites": [
        "accessibility",
        "screen_recording"
      ],
      "toolId": "computer.control"
    },
    {
      "description": "Read the current non-Tro browser tab or application window using structured semantics first. It returns opaque element references and falls back to vision when needed.",
      "modelName": "observe_surface",
      "operationSelector": {
        "kind": "json_pointer",
        "nullValue": "observe",
        "pointer": "/observationId",
        "presentValue": "inspect_surface_region"
