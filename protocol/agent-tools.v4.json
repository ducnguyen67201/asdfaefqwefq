                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "reason",
          "query",
          "observationId",
          "region"
        ],
        "type": "object"
      },
      "prerequisites": [
        "accessibility",
        "screen_recording"
      ],
      "toolId": "computer.observe"
    },
    {
