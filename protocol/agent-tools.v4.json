                  "height": {
                    "maximum": 1000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "width": {
                    "maximum": 1000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "x": {
                    "maximum": 999,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "y": {
                    "maximum": 999,
                    "minimum": 0,
                    "type": "integer"
                  }
