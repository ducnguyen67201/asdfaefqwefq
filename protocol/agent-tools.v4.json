              {
                "type": "null"
              }
            ]
          },
          "query": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "maxLength": 500,
            "type": "string"
          },
          "region": {
            "anyOf": [
              {
                "additionalProperties": false,
