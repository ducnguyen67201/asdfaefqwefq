load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_deps", "crate_edition")
load(
    "@rules_rust//rust:defs.bzl",
    "rust_binary",
    "rust_library",
    "rust_test",
)
load(
    "//bazel/rust:defs.bzl",
    "trocode_rust_checks",
    "trocode_rust_integration_test",
    "trocode_rust_lint_config",
)

trocode_rust_lint_config(
    name = "rust_lints",
)

rust_library(
    name = "api_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    compile_data = glob([
        "migrations/*.sql",
        "public/*",
    ]),
    crate_name = "trocode_api",
    edition = crate_edition(),
    lint_config = ":rust_lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "trocode_api",
    srcs = ["src/main.rs"],
    crate_name = "trocode_api_server",
    edition = crate_edition(),
    lint_config = ":rust_lints",
    visibility = ["//visibility:public"],
    deps = [":api_lib"] + crate_deps([
        "anyhow",
        "clap",
        "tokio",
    ]),
)

trocode_rust_integration_test(
    name = "agent_runtime_compat_test",
    size = "large",
    src = "tests/agent_runtime_compat.rs",
    tags = ["requires-postgres"],
)

trocode_rust_integration_test(
    name = "classroom_e2e_test",
    size = "large",
    src = "tests/classroom_e2e.rs",
    tags = ["requires-postgres"],
)

trocode_rust_integration_test(
    name = "contract_corpus_test",
    size = "small",
    src = "tests/contract_corpus.rs",
    compile_data = glob([
        "migrations/*.sql",
        "tests/fixtures/*",
    ]),
)

trocode_rust_integration_test(
    name = "google_auth_compat_test",
    size = "small",
    src = "tests/google_auth_compat.rs",
)

trocode_rust_integration_test(
    name = "http_compat_test",
    size = "large",
    src = "tests/http_compat.rs",
    tags = [
        "requires-postgres",
        "requires-s3",
    ],
)

trocode_rust_integration_test(
    name = "ingestion_test",
    size = "large",
    src = "tests/ingestion.rs",
    tags = [
        "requires-postgres",
        "requires-s3",
    ],
)

trocode_rust_integration_test(
    name = "parser_properties_test",
    size = "small",
    src = "tests/parser_properties.rs",
)

trocode_rust_integration_test(
    name = "postgres_compat_test",
    src = "tests/postgres_compat.rs",
    compile_data = glob(["migrations/*.sql"]),
    tags = ["requires-postgres"],
)

trocode_rust_integration_test(
    name = "provider_budget_compat_test",
    size = "large",
    src = "tests/provider_budget_compat.rs",
    tags = ["requires-postgres"],
)

RUST_TEST_TARGETS = [
    ":agent_runtime_compat_test",
    ":api_lib_test",
    ":classroom_e2e_test",
    ":contract_corpus_test",
    ":google_auth_compat_test",
    ":http_compat_test",
    ":ingestion_test",
    ":parser_properties_test",
    ":postgres_compat_test",
    ":provider_budget_compat_test",
]

rust_test(
    name = "api_lib_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":api_lib",
    edition = crate_edition(),
    lint_config = ":rust_lints",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

trocode_rust_checks(
    clippy_name = "clippy",
    rustfmt_name = "rustfmt_test",
    source_targets = [
        ":api_lib",
        ":trocode_api",
    ],
    test_targets = RUST_TEST_TARGETS,
)
