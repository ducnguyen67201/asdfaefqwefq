load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load(
    "@rules_rust//rust:defs.bzl",
    "rust_binary",
    "rust_clippy",
    "rust_library",
    "rust_lint_config",
    "rust_test",
    "rustfmt_test",
)

rust_lint_config(
    name = "rust_lints",
    clippy = {
        "all": "deny",
    },
    rustc = {
        "unsafe_code": "forbid",
    },
)

rust_library(
    name = "api_lib",
    srcs = ["src/lib.rs"],
    aliases = aliases(),
    crate_name = "trocode_api",
    edition = crate_edition(),
    lint_config = ":rust_lints",
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_binary(
    name = "trocode_api",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_name = "trocode_api_server",
    edition = crate_edition(),
    lint_config = ":rust_lints",
    visibility = ["//visibility:public"],
    deps = [":api_lib"] + all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "api_lib_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":api_lib",
    edition = crate_edition(),
    lint_config = ":rust_lints",
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rustfmt_test(
    name = "rustfmt_test",
    targets = [
        ":api_lib",
        ":trocode_api",
    ],
)

rust_clippy(
    name = "clippy",
    testonly = True,
    deps = [
        ":api_lib",
        ":api_lib_test",
        ":trocode_api",
    ],
)
